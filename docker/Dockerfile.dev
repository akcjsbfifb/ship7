FROM node:22-alpine

RUN --network=host npm install -g pnpm@10.14.0

WORKDIR /app

RUN apk add --no-cache libc6-compat openssl python3 py3-pip \
  && pip3 install --break-system-packages --no-cache-dir 'markitdown[all]' \
  || pip3 install --break-system-packages --no-cache-dir markitdown


COPY package.json pnpm-lock.yaml ./
RUN --network=host --mount=type=cache,target=/root/.local/share/pnpm/store \
    pnpm install --frozen-lockfile

COPY . .

RUN pnpm exec prisma generate

COPY docker/entrypoint.dev.sh /entrypoint.dev.sh
RUN chmod +x /entrypoint.dev.sh

EXPOSE 3000

ENTRYPOINT ["/entrypoint.dev.sh"]
CMD ["pnpm", "exec", "next", "dev", "--turbopack", "-H", "0.0.0.0"]
