generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("POSTGRES_URL")
}

enum Role {
  TEACHER
  STUDENT
}

model User {
  id           String       @id @default(cuid())
  firebaseUid  String       @unique
  email        String       @unique
  name         String?
  role         Role         @default(STUDENT)
  createdAt    DateTime     @default(now())
  coursesOwned Course[]     @relation("CourseTeacher")
  enrollments  Enrollment[]
}

model Course {
  id          String       @id @default(cuid())
  title       String
  description String?
  inviteCode  String       @unique
  teacherId   String
  teacher     User         @relation("CourseTeacher", fields: [teacherId], references: [id])
  enrollments Enrollment[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model Enrollment {
  id        String   @id @default(cuid())
  courseId  String
  userId    String
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([courseId, userId])
  @@index([userId])
}

/// Chunks vectorizados aislados por curso (multi-tenancy via metadata filtering).
model documents {
  id        BigInt                 @id @default(autoincrement())
  courseId  String // AISLAMIENTO: Identificador del curso
  content   String?
  embedding Unsupported("vector")? // Vector de OpenAI (1536 dimensiones)
  metadata  Json?                  @default("{}") // Metadatos extra (autor, tipo, etc)
  createdAt DateTime               @default(now())
  updatedAt DateTime               @updatedAt

  @@index([courseId])
}
