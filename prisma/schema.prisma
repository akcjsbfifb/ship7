generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("POSTGRES_URL")
}

enum Role {
  TEACHER
  STUDENT
}

enum MaterialStatus {
  PROCESSING
  READY
  FAILED
}

model User {
  id           String       @id @default(cuid())
  firebaseUid  String       @unique
  email        String       @unique
  name         String?
  role         Role         @default(STUDENT)
  createdAt    DateTime     @default(now())
  coursesOwned Course[]     @relation("CourseTeacher")
  enrollments  Enrollment[]
  chatThreads  ChatThread[]
}

model Course {
  id                String        @id @default(cuid())
  title             String
  description       String?
  inviteCode        String        @unique
  teacherId         String
  teacher           User          @relation("CourseTeacher", fields: [teacherId], references: [id])
  tutorInstructions String?
  tutorPresetKeys   String[]      @default([])
  enrollments       Enrollment[]
  topics            CourseTopic[]
  materials         Material[]
  chatThreads       ChatThread[]
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
}

model Enrollment {
  id        String   @id @default(cuid())
  courseId  String
  userId    String
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([courseId, userId])
  @@index([userId])
}

model CourseTopic {
  id          String     @id @default(cuid())
  courseId    String
  title       String
  description String?
  position    Int        @default(0)
  course      Course     @relation(fields: [courseId], references: [id], onDelete: Cascade)
  materials   Material[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([courseId])
}

model Material {
  id           String         @id @default(cuid())
  topicId      String
  courseId     String
  title        String
  filename     String
  mimeType     String
  storagePath  String
  sizeBytes    Int
  status       MaterialStatus @default(PROCESSING)
  errorMessage String?
  extractedMd  String?
  topic        CourseTopic    @relation(fields: [topicId], references: [id], onDelete: Cascade)
  course       Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)
  createdAt    DateTime       @default(now())

  @@index([courseId])
  @@index([topicId])
}

model ChatThread {
  id        String        @id @default(cuid())
  courseId  String
  userId    String
  title     String?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  messages  ChatMessage[]
  course    Course        @relation(fields: [courseId], references: [id], onDelete: Cascade)
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([courseId])
  @@index([courseId, userId])
}

model ChatMessage {
  id        String     @id @default(cuid())
  threadId  String
  role      String
  content   String
  createdAt DateTime   @default(now())
  thread    ChatThread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@index([threadId])
}

/// Chunks vectorizados aislados por curso (multi-tenancy via metadata filtering).
model documents {
  id        BigInt                 @id @default(autoincrement())
  courseId  String // AISLAMIENTO: Identificador del curso
  content   String?
  embedding Unsupported("vector")? // Vector de OpenAI (1536 dimensiones)
  metadata  Json?                  @default("{}") // Metadatos extra (autor, tipo, etc)
  createdAt DateTime               @default(now())
  updatedAt DateTime               @updatedAt

  @@index([courseId])
}
