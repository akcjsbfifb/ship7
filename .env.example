# ── PostgreSQL (pgvector) ──
POSTGRES_USER=eduai
POSTGRES_PASSWORD=eduai
POSTGRES_DB=eduai

# ── Puertos ──
PUERTO_FRONTEND=3000
PUERTO_POSTGRES=5432
PUERTO_INNGEST=8288

# ── Vercel AI Gateway (REQUIRED for chat + embeddings) ──
# Dashboard → AI Gateway → API Keys → Create key
AI_GATEWAY_API_KEY=

# ── Inngest (cloud / prod opcional) ──
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# ── Derivadas (usadas por Prisma / node-pg; compose también las setea) ──
POSTGRES_URL=postgresql://eduai:eduai@localhost:5432/eduai?schema=public
PGUSER=eduai
PGPASSWORD=eduai
PGHOST=localhost
PGPORT=5432
PGDATABASE=eduai
PGSSL=false
SKIP_ENV_VALIDATION=1
