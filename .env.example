# ── PostgreSQL (pgvector) ──
POSTGRES_USER=eduai
POSTGRES_PASSWORD=eduai
POSTGRES_DB=eduai

# ── Puertos ──
PUERTO_FRONTEND=3000
PUERTO_POSTGRES=5432

# ── OpenAI ──
OPENAI_API_KEY=

# ── Firebase Admin (server) ──
# Option A: individual env vars
# FIREBASE_PROJECT_ID=ship7-a8c70
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk-...@ship7-a8c70.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Option B: service account JSON path (local)
GOOGLE_APPLICATION_CREDENTIALS=./firebase-service-account.json

FIREBASE_STORAGE_BUCKET=ship7-a8c70.firebasestorage.app

# Upload driver: firebase (Storage) | local (disk volume)
UPLOAD_DRIVER=firebase
UPLOAD_DIR=./data/uploads

# Firebase client config is hardcoded in src/lib/firebase/client.ts

# ── Derivadas ──
POSTGRES_URL=postgresql://eduai:eduai@localhost:5432/eduai?schema=public
PGUSER=eduai
PGPASSWORD=eduai
PGHOST=localhost
PGPORT=5432
PGDATABASE=eduai
PGSSL=false
SKIP_ENV_VALIDATION=1
